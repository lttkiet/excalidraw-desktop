{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excalidraw Desktop",
  "version": "0.1.0",
  "identifier": "com.excalidraw.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Excalidraw Desktop",
        "width": 1360,
        "height": 900,
        "minWidth": 880,
        "minHeight": 600,
        "backgroundColor": "#f7f7f4"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' asset: http://asset.localhost; script-src 'self' 'unsafe-eval' asset: http://asset.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Graphics and Design",
    "shortDescription": "Offline sketching and diagrams",
    "linux": {
      "rpm": {
        "depends": ["libwebkit2gtk-4_1-0"]
      }
    }
  }
}
