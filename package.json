{
  "name": "excalidraw-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy:fonts": "node scripts/copy-excalidraw-fonts.mjs",
    "predev": "npm run copy:fonts",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run copy:fonts",
    "build": "tsc -b && vite build --configLoader runner",
    "test": "vitest run --configLoader runner",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build:windows": "tauri build --bundles msi",
    "tauri:build:ubuntu": "tauri build --bundles deb,appimage",
    "tauri:build:opensuse": "tauri build --bundles rpm",
    "tauri:build:linux": "tauri build --bundles appimage,deb,rpm"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^5.0.3"
  }
}
